{
  "name": "toolplane",
  "version": "0.0.0",
  "private": true,
  "description": "Toolplane monorepo for ToolGuard, a protocol-independent ToolOps layer for AI agent tool calls.",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "demo": "pnpm --filter @toolplane/mcp-adapter demo:portfolio",
    "demo:mcp": "pnpm --filter @toolplane/mcp-adapter demo",
    "demo:openobserve": "pnpm --filter @toolplane/core demo:openobserve",
    "demo:otel": "pnpm --filter @toolplane/core demo:otel",
    "demo:raw-failure": "pnpm --filter @toolplane/core demo:raw-failure",
    "demo:serve": "pnpm --filter @toolplane/mcp-adapter demo:serve",
    "demo:toolplane": "pnpm --filter @toolplane/core demo:toolplane",
    "doctor:integrations": "pnpm --filter @toolplane/core doctor:integrations",
    "dev:core": "pnpm --filter @toolplane/core dev",
    "dev:fixtures": "pnpm --filter @toolplane/mcp-adapter dev:fixtures",
    "dev:ui": "pnpm --filter @toolplane/ui dev -- --host 127.0.0.1 --port 3661",
    "changeset": "changeset",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:generate": "typedoc --json docs-api.json",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . && pnpm -r lint",
    "proof:integrations": "pnpm --silent doctor:integrations -- --json && pnpm --filter @toolplane/core test -- integration-doctor.test.ts api-openapi-drift.test.ts api-runtime-contract.test.ts",
    "quality": "node scripts/check-feature-flags.mjs && node scripts/check-todos.mjs && node scripts/check-branch-protection.mjs && node scripts/check-backlog-health-config.mjs && node scripts/check-observability-stack.mjs && node scripts/check-validation-gate.mjs && pnpm --filter @toolplane/python-adapters complexity && pnpm --filter @toolplane/python-adapters deadcode && knip --no-progress --include dependencies,unlisted,binaries && syncpack lint --dependency-types prod,dev,peer && depcruise --config .dependency-cruiser.cjs packages --output-type err && jscpd --silent",
    "observability:config": "node scripts/openobserve-stack.mjs config",
    "observability:down": "node scripts/openobserve-stack.mjs down",
    "observability:up": "node scripts/openobserve-stack.mjs up",
    "profile:core": "clinic doctor -- node packages/core/dist/server.js",
    "security:secrets": "gitleaks detect --no-git --redact --source .",
    "size": "size-limit",
    "release:version": "changeset version",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm docs:check && pnpm proof:integrations && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm quality && pnpm build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,yml,yaml}": "prettier --check",
    "*.{js,jsx,ts,tsx}": "eslint"
  },
  "size-limit": [
    {
      "path": "packages/ui/dist/assets/*.js",
      "limit": "250 KB"
    }
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@size-limit/preset-app": "^12.1.0",
    "@toolplane/cli": "workspace:*",
    "@toolplane/ui": "workspace:*",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "clinic": "^13.0.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "husky": "^9.1.7",
    "jscpd": "^5.0.11",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "size-limit": "^12.1.0",
    "syncpack": "^15.3.2",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "posthog-js": "^1.398.0",
    "prom-client": "^15.1.3"
  }
}
