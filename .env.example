# ToolGuard local development defaults
NODE_ENV=development
TOOLGUARD_CORE_HOST=127.0.0.1
TOOLGUARD_CORE_PORT=3660
TOOLGUARD_UI_HOST=127.0.0.1
TOOLGUARD_UI_PORT=3661
TOOLGUARD_FIXTURE_PORT_START=3662
TOOLGUARD_FIXTURE_PORT_END=3664

# Optional sidecar endpoint for Python framework adapters
TOOLGUARD_SIDECAR_ENDPOINT=http://127.0.0.1:3660/api/sidecar/v1/tool-calls

# Optional local-only integration profile path
TOOLGUARD_PROFILE=./toolguard.profile.json

# Optional error tracking and product analytics
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
